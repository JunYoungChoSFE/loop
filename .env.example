# Roost — environment variables.
# Copy this file to `.env` (gitignored) and fill in real values on each machine / Codespace.
# In Codespaces, prefer "Codespaces secrets" over a committed file.

# ── Shopify app (required for `shopify app dev`) ──────────────────────────────
# Found in the Partner Dashboard, or auto-injected by `shopify app dev`.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_orders,write_orders,read_customers,write_customers,write_discounts
# Public URL of the app (tunnel URL in dev, fly.dev URL in prod). `shopify app dev` sets this.
SHOPIFY_APP_URL=
# Optional: only set when testing against a custom storefront domain.
SHOP_CUSTOM_DOMAIN=

# ── Prediction cron (Roost v2) ────────────────────────────────────────────────
# Shared secret guarding POST /internal/predict (manual / external trigger).
CRON_SECRET=
# Set to "1" to disable the in-process nightly prediction batch (e.g. on dev machines).
DISABLE_PREDICTION_CRON=

# ── Email (Resend) — auto reminder / winback sends ────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=

# ── Production only (Fly + Litestream SQLite backup) ──────────────────────────
# Leave blank for local/Codespaces dev (Prisma uses file:dev.sqlite there).
BUCKET_NAME=
