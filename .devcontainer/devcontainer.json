{
  "name": "Roost (Shopify loyalty app)",
  // Node 22 — required by @shopify/cli@4.1.0 (>=22.12.0); also satisfies package.json engines.
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  // Install deps + generate Prisma client + create the local SQLite dev DB.
  // Shopify CLI is a devDependency, so npm install brings it in — no global install needed.
  "postCreateCommand": "npm install && npx prisma generate && npx prisma migrate deploy",
  // Shopify CLI's dev tunnel + the app's vite/frontend ports.
  "forwardPorts": [3000, 8002, 9292],
  "portsAttributes": {
    "3000": { "label": "app", "onAutoForward": "notify" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "Prisma.prisma",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "GraphQL.vscode-graphql"
      ]
    }
  }
  // No .env needed for core dev: `shopify app dev` injects the Shopify keys after
  // Partner login. Only optional secrets (RESEND_API_KEY, CRON_SECRET, EMAIL_FROM)
  // need Codespaces secrets — see SETUP.md.
}
